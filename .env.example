# AURA 환경변수 예시 파일
# 실제 값은 .env 또는 배포 시크릿에만 저장한다.

# 데이터베이스
DB_HOST=localhost
DB_PORT=3306
DB_NAME=aura_db
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password

# JWT
# 운영 환경에서는 충분히 긴 난수 문자열을 사용한다.
JWT_SECRET=replace-with-at-least-32-byte-secret-key

# Google Refresh Token AES-256-GCM 암호화 키(Base64 인코딩 32바이트)
TOKEN_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key

# Google OAuth / Google API
GOOGLE_CLIENT_ID=k20ilr77tb3q9q0og8m255s25qqos2m7.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=your-google-redirect-uri

# Firebase Cloud Messaging
FCM_CREDENTIAL_PATH=./firebase-service-account.json

# Vertex Gemini API
# 서버는 이 키를 x-goog-api-key 요청 헤더로만 전송한다.
VERTEX_API_KEY=your-vertex-api-key
VERTEX_API_URL=https://aiplatform.googleapis.com/v1beta1/projects/{project}/locations/{location}/publishers/google/models/gemini-2.5-flash-lite:generateContent
VERTEX_GEMINI_MODEL=gemini-2.5-flash-lite

# AURA AI 분석
AURA_AI_PROVIDER=VERTEX_GEMINI
AURA_AI_ANALYSIS_ENABLED=true
AURA_AI_BATCH_SIZE=20
AURA_AI_REQUEST_TIMEOUT_SECONDS=30


