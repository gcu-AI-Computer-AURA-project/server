DB_HOST=localhost
DB_PORT=your_db_port
DB_NAME=your_db_name
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password

# JWT
# Use a sufficiently long random secret in real environments.
JWT_SECRET=replace-with-at-least-32-byte-secret-key

# Google Refresh Token AES-256-GCM encryption key (Base64 encoded 32 bytes)
TOKEN_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key

# Google OAuth / Google API
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=your-google-redirect-uri

# Firebase Cloud Messaging
FCM_CREDENTIAL_PATH=./firebase-service-account.json

# ONNX ML Model
# Docker deployment path example: /app/models/aura-classifier-v1.onnx
AURA_ML_CLASSIFIER_VERSION=aura-onnx-classifier-v1
AURA_ML_MODEL_PATH=models/aura-classifier-v1.onnx
